FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Local GPU model server — loads the LLM into VRAM and runs LoRA training.
# Used with local_gpu_serve.py on machines that have an NVIDIA GPU (e.g. EC2 G-series).
#
# Model weights are NOT baked into this image to keep it lean (~7 GB).
# Instead, entrypoint.sh downloads weights to the hf_cache Docker volume on
# first startup (~5 min one-time) and skips the download on all subsequent starts.
#
# Usage:
#   docker compose build model_server
#   docker compose up -d model_server

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3-pip gcc curl \
    && ln -sf python3.11 /usr/bin/python3 \
    && ln -sf python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.model.gpu.txt .
RUN pip install --no-cache-dir -r requirements.model.gpu.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

VOLUME /adapters

EXPOSE 8001

# entrypoint.sh downloads the model to hf_cache on first run, then starts the server
COPY model_server/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
