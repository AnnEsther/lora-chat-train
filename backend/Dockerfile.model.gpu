FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Local GPU model server — loads the LLM into VRAM and runs LoRA training.
# Used with local_gpu_serve.py on machines that have an NVIDIA GPU (e.g. EC2 G-series).
#
# Build args HF_TOKEN and BASE_MODEL are used at build time to pre-download
# the model weights into the image so the container starts immediately without
# waiting for a download (~2.4 GB baked in, one-time cost at build).
#
# Usage:
#   docker build --build-arg HF_TOKEN=hf_xxx \
#                --build-arg BASE_MODEL=meta-llama/Llama-3.2-1B-Instruct \
#     -f Dockerfile.model.gpu -t lora-model-server-gpu .
#   docker run --gpus all -p 8001:8001 lora-model-server-gpu

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3-pip gcc curl git-lfs \
    && ln -sf python3.11 /usr/bin/python3 \
    && ln -sf python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.model.gpu.txt .
RUN pip install --no-cache-dir -r requirements.model.gpu.txt

# ── Pre-download model weights at build time ──────────────────────────────────
# Baking weights into the image means container startup is immediate —
# no waiting for HuggingFace download on every deploy.
# The ARGs are used only in this RUN layer; they are not persisted as ENV.
ARG HF_TOKEN=""
ARG BASE_MODEL="meta-llama/Llama-3.2-1B-Instruct"

RUN python3 -c "\
import os; \
from huggingface_hub import snapshot_download; \
token = '${HF_TOKEN}'; \
model = '${BASE_MODEL}'; \
print(f'Pre-downloading {model} into image cache ...'); \
snapshot_download( \
    repo_id=model, \
    token=token if token else None, \
    ignore_patterns=['*.msgpack', '*.h5', 'flax_model*', 'tf_model*', 'rust_model*'], \
); \
print('Model download complete.') \
"

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

VOLUME /adapters

EXPOSE 8001

CMD ["python", "-m", "model_server.local_gpu_serve"]
