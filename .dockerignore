# Git history
.git/
.gitignore

# Python virtualenv and cache
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
.ruff_cache/

# Node modules and build output
frontend/node_modules/
frontend/.next/
glyph_chat/node_modules/
